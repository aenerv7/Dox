// Launcher.rc — 资源脚本（UTF-8）
#include <windows.h>
#include "Resource.h"

IDI_APP ICON "Launcher.ico"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "DeepSeek Harness"
            VALUE "FileDescription", "DeepSeek Harness 托盘启动器"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Launcher"
            VALUE "OriginalFilename", "Launcher.exe"
            VALUE "ProductName", "DeepSeek Harness Launcher"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
