{
  "name": "sub-store-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sub-Store backend adapter for Cloudflare Workers (D1 storage, path-token auth).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && node scripts/smoke.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "ms": "^2.1.3",
    "nanoid": "^3.3.11",
    "peggy": "^2.0.1",
    "wrangler": "^4.42.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
