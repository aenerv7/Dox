{
  "manifest_version": 3,
  "name": "Dox Reader",
  "version": "1.1.14",
  "description": "RSS reader with local mode, WebDAV sync and an optional self-hosted Dox Reader Backend.",
  "author": "aenerv7",
  "homepage_url": "https://github.com/aenerv7/Dox/tree/main/Firefox/Add-Ons/Dox%20Reader",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "打开 Dox Reader",
    "default_icon": "icons/icon-32.png"
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dox-reader@magi",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "websiteActivity",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
