{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.2.4",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "aenerv7",
  "homepage_url": "https://github.com/aenerv7/Dox/tree/main/Firefox/AutoSortBookmarks",
  "permissions": [
    "alarms",
    "bookmarks",
    "storage"
  ],
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "sorter.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "id": "auto-sort-bookmarks@dox.local",
      "strict_min_version": "142.0"
    }
  }
}
