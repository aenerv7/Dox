.DS_Store

# Scripts logs
Scripts/*_dbg.log
Scripts/*_hlpr.log
Scripts/RemoveMSEdge-backups/

# Swift
SizerSwift/.build/
SizerSwift/build/

# SizerWin
SizerWin/SizerWin.exe
SizerWin/SizerWin_new.exe
SizerWin/*.obj
SizerWin/*.res
SizerWin/SizerWin.ini

# CapsLockOSD
CapsLockOSD/CapsLockOSD.exe
CapsLockOSD/*.obj
CapsLockOSD/*.res
CapsLockOSD/CapsLockOSD.ini

# Dox Reader（本地依赖与构建产物）
Dox Reader/**/node_modules/
Dox Reader/**/dist/
Dox Reader/**/.wrangler/
Dox Reader/**/.dev.vars
Dox Reader/**/.env*

# Firefox extensions
Firefox/**/web-ext-artifacts/
Firefox/**/.amo-upload-uuid

# Firefox 扩展源码目录（本地依赖、构建产物与发布凭据）
Firefox/Add-Ons/**/node_modules/
Firefox/Add-Ons/**/dist/
Firefox/Add-Ons/**/*.log
Firefox/Add-Ons/**/.env.release

# Firefox registry scripts
Firefox/__pycache__/

# DeepSeek Harness Launcher（构建产物）
DeepSeek Harness/Launcher/bin/

# ApkRename（自动下载的工具）
Scripts/tools/

# Codex temporary workspace files
.codex-tmp/

# Sub-Store 部署产物与本地上游源码
sub-store/**/.upstream/
sub-store/**/build/
sub-store/**/node_modules/
sub-store/**/.wrangler/

# Sub-Store-Front-End 上游 release 解压产物与本地依赖
sub-store-front-end/**/dist/
sub-store-front-end/**/build/
sub-store-front-end/**/node_modules/
sub-store-front-end/**/.wrangler/

# bwh-traffic Worker 本地依赖与 wrangler 状态
bwh-traffic/**/node_modules/
bwh-traffic/**/.wrangler/
